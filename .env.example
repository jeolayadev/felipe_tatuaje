# Configuración de Firebase (Consola Firebase → ⚙ Configuración del proyecto →
# "Tus apps" → SDK → Configuración). Copia este archivo como .env.local y pega
# tus valores. Estos datos NO son secretos: la seguridad va en las Reglas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
