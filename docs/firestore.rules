rules_version = '2';

// Reglas de seguridad de Firestore para Inkepilef — VERSIÓN 2 (con registro abierto).
// Cópialas en: Consola Firebase → Firestore Database → Reglas → Publicar.
//
// IMPORTANTE: como ahora cualquiera puede crear una cuenta desde la web,
// "estar autenticado" YA NO da permisos de administración. Solo el correo
// oficial del estudio administra.

service cloud.firestore {
  match /databases/{database}/documents {

    match /config/{document} {
      allow read: if true;           // la web necesita leer horario/galería/pagos
      allow write: if isAdmin();
    }

    match /bookings/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isValidBooking();  // cualquier visitante puede reservar
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'inkepilef.1401@gmail.com';
    }

    function isValidBooking() {
      let d = request.resource.data;
      return d.keys().hasAll(['date', 'time', 'name', 'contact', 'idea', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() < 120
        && d.contact is string && d.contact.size() > 0 && d.contact.size() < 200
        && d.date is string && d.time is string
        && d.idea is string && d.idea.size() < 2000;
    }
  }
}
