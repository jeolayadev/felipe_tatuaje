rules_version = '2';

// Reglas de Firebase Storage para Inkepilef.
// Cópialas en: Consola Firebase → Storage → Reglas → Publicar.
//
// Las fotos de la galería son públicas para leer (la web las muestra a todos)
// y solo el correo oficial del estudio puede subir/borrar. Límite 5 MB/imagen.

service firebase.storage {
  match /b/{bucket}/o {
    match /gallery/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'inkepilef.1401@gmail.com'
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
